{
  "name": "coolcloud-community",
  "version": "2.0.0",
  "description": "CoolCloud Community - a secure, self-hosted collaboration suite for files, calendar, mail, contacts, editor, tasks and team chat.",
  "type": "module",
  "bin": {
    "coolcloud": "bin/coolcloud.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/coolcloud.js --start",
    "install-cc": "node bin/coolcloud.js --install"
  },
