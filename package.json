    "self-hosted",
    "collaboration",
    "files",
    "calendar",
    "mail",
    "contacts",
    "editor"
  ],
  "license": "MIT",
  "files": [
    "bin",
    "server",
    "web",
    "docs",
    "cc-cli",
    "appstore",
    "EDITION",
    "README.md"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1"
  },
  "homepage": "https://coolcloud.odoo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openhcat/CoolCloud-Community.git"
  }
}
