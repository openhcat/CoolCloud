{
  "version": 2,
  "edition": "community",
  "name": "CoolCloud",
  "website": "https://openhcat.github.io/cc-appregistry/",
  "host": "0.0.0.0",
  "port": 8080,
  "publicUrl": "http://localhost:8080",
  "timezone": "system",
  "branding": {
    "tagline": "Your workspace, on your machine",
    "logoWord": "Cloud",
    "mark": "cl",
    "accent": "#0b5fb0",
    "logo": ""
  },
  "storage": {
    "mode": "unlimited",
    "totalGb": null,
    "defaultUserQuotaMb": null
  },
  "limits": {
    "maxUsers": 0
  },
  "apps": {
    "core": ["files", "calendar", "mail", "contacts", "editor", "tasks"],
    "essentials": ["connect", "media", "assistant", "crm", "finance", "projects", "studio"],
    "essentialsInstalled": false,
    "disabled": []
  },
  "appstore": {
    "official": "https://raw.githubusercontent.com/openhcat/cc-appregistry/main/registry.json",
    "registries": ["https://raw.githubusercontent.com/openhcat/cc-appregistry/main/registry.json"]
  },
  "editor": {
    "text": true,
    "officeProvider": "collabora",
    "officeUrl": "",
    "officeContainer": "coolcloud-office",
    "autoHost": true,
    "wopiHost": "",
    "wopiSecret": ""
  },
  "mail": {
    "allowUserSmtp": true,
    "allowUserImap": true
  },
  "features": {
    "search": true,
    "appstore": true,
    "assistant": false,
    "connect": false,
    "media": false,
    "crm": false,
    "finance": false,
    "projects": false,
    "studio": false
  },
  "security": {
    "sessionDays": 14,
    "allowSignups": false,
    "trustProxy": true
  }
}
